# Copy to .env and fill in. .env stays on the server.
TRANSLATOR_LOGIN=translator
TRANSLATOR_PASSWORD=
TRANSLATOR_NAME=The Translator
TRANSLATOR_STATUS=Say it in any language!
# Translations come from Google Translate's free endpoint. For a LibreTranslate server instead:
# TRANSLATE_ENGINE=libre
# TRANSLATE_URL=http://my-libretranslate:5000
# The Hotline Central Hub's public chat (host.docker.internal when it's on this same machine), where it answers "!translate ..." (empty: stay out)
HUB_HOST=host.docker.internal
HUB_ICON=24433
