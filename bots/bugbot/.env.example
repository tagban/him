# Copy to .env and fill in. .env stays on the server.
BUGBOT_LOGIN=bugbot
BUGBOT_PASSWORD=
BUGBOT_NAME=BugBot
BUGBOT_STATUS=Found a bug? Tell me!
# A fine-grained GitHub token with "Issues: Read and write" on tagban/him only.
# Without it, reports are kept in data/reports.json instead.
GITHUB_TOKEN=
GITHUB_REPO=tagban/him
BUGBOT_LABEL=from BugBot
# Screenshots: a public repo just for them (so the issues can show them), and a
# second fine-grained token with "Contents: Read and write" on that repo only.
# Without these, screenshots are kept in data/shots and the issue says so.
BUGBOT_SHOTS_REPO=
BUGBOT_SHOTS_TOKEN=
