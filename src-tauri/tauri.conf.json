{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HIM",
  "version": "0.1.1",
  "identifier": "com.tagban.him",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "signon",
        "url": "signon.html",
        "title": "Sign On",
        "width": 212,
        "height": 404,
        "resizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "SocialNetworking",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../icons/badassbuddy/": "badassbuddy/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
